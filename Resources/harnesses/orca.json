        "argv0": "/Applications/Orca.app/Contents/MacOS/Orca",
        "expected": true,
        "evidence": "https://orca.computer/",
        "verifiedAt": "2026-09-20"
      },
      {
        "method": "collision: an Electron helper of the same app",
        "path": "/Applications/Orca.app/Contents/Frameworks/Orca Helper.app/Contents/MacOS/Orca Helper",
        "name": "Orca Helper",
        "argv0": "Orca Helper",
        "expected": false,
        "evidence": "https://orca.computer/",
        "verifiedAt": "2026-09-20"
      },
      {
        "method": "collision: the bundled computer-use agent",
        "path": "/Applications/Orca.app/Contents/Resources/Orca Computer Use.app/Contents/MacOS/orca-computer-use-macos",
        "name": "orca-computer-use-macos",
        "argv0": "orca-computer-use-macos",
        "expected": false,
        "evidence": "https://orca.computer/",
        "verifiedAt": "2026-09-20"
      }
