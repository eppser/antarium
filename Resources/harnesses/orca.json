    "note": "Read through the published CLI command schema; validate against a running instance with --check."
  },
  "source": {
    "kind": "command",
    "path": "",
    "command": "orca",
    "args": [
      "terminal",
      "list",
      "--json"
    ],
    "root": "result.terminals",
    "refreshEvery": 10
