{
  "formatVersion": 1,
  "id": "kimi",
  "name": "Kimi",
  "process": {
    "pathContains": ["kimi-code", "/.kimi"],
    "names": ["kimi"],
    "argv0Contains": ["/@moonshot-ai/kimi-code/"],
    "installationProbes": [
      { "method": "curl", "path": "/fixture/home/.kimi-code/bin/kimi", "name": "kimi", "argv0": "kimi", "expected": true, "evidence": "https://github.com/MoonshotAI/kimi-code/blob/main/docs/en/guides/getting-started.md", "verifiedAt": "2026-08-26" },
      { "method": "npm", "path": "/usr/bin/node", "name": "node", "argv0": "/fixture/lib/node_modules/@moonshot-ai/kimi-code/bin/kimi.js", "expected": true, "evidence": "https://github.com/MoonshotAI/kimi-code/blob/main/docs/en/guides/getting-started.md", "verifiedAt": "2026-08-26" },
      { "method": "name-collision", "path": "/fixture/tools/kimiko", "name": "kimiko", "argv0": "kimiko", "expected": false, "evidence": "https://github.com/MoonshotAI/kimi-code", "verifiedAt": "2026-08-26" }
    ]
  },
  "compatibility": {
    "level": "fixtureVerified", "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/kimi.json"
  },
  "source": {
    "kind": "jsonl",
    "path": "~/.kimi-code/sessions",
    "glob": "*/*/agents/main/wire.jsonl",
    "manifest": {
      "file": "../../state.json",
      "map": {
        "cwd": "cwd",
        "title": "title",
        "subAgents": {
          "path": "agents",
          "match": {
            "type": "sub"
          }
        }
      }
    }
  },
  "map": {
    "model": "model",
    "timestamp": "time",
    "inputTokens": "usage.inputOther",
    "outputTokens": "usage.output",
    "cacheRead": "usage.inputCacheRead",
    "cacheWrite": "usage.inputCacheCreation",
    "contextTokens": [
      "tokens"
    ],
    "contextWindow": "maxTokens",
    "toolWhere": { "type": "tool.call" },
    "turnWhere": {
      "type": "turn.ended"
    }
  }
}
