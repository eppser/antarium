{
  "formatVersion": 1,
  "id": "cursor-cli",
  "name": "Cursor CLI",
  "process": {
    "pathContains": [
      "/cursor-agent"
    ],
    "names": [
      "cursor-agent",
      "agent"
    ],
    "installationProbes": [
      {
        "method": "curl-cursor-agent",
        "path": "/fixture/home/.local/share/cursor-agent/versions/2026.08.11/cursor-agent",
        "name": "cursor-agent",
        "argv0": "cursor-agent",
        "expected": true,
        "evidence": "https://docs.cursor.com/en/cli/installation",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "curl-agent-alias",
        "path": "/fixture/home/.local/share/cursor-agent/versions/2026.08.11/cursor-agent",
        "name": "agent",
        "argv0": "agent",
        "expected": true,
        "evidence": "https://docs.cursor.com/en/cli/installation",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "desktop-helper",
        "path": "/Applications/Cursor.app/Contents/Frameworks/Cursor Helper.app/Contents/MacOS/Cursor Helper",
        "name": "Cursor Helper",
        "argv0": "Cursor Helper",
        "expected": false,
        "evidence": "https://docs.cursor.com/en/cli/installation",
        "verifiedAt": "2026-08-26"
      }
    ]
  },
  "compatibility": {
    "level": "fixtureVerified",
    "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/cursor-cli.json"
  },
  "source": {
    "kind": "json",
    "path": "~/.cursor/chats",
    "glob": "*/*/meta.json"
  },
  "map": {
    "cwd": "cwd",
    "title": "title",
    "timestamp": "updatedAtMs"
  },
  "presentation": {
    "fallbackName": "Cursor CLI"
  },
  "capabilities": {
    "instruction": {
      "probe": "content",
      "project": [
        ".cursor/rules",
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "fileSuffixes": [
        ".mdc"
      ]
    }
  },
  "note": "The CLI's own documentation states it supports the same rules system as the editor and additionally reads AGENTS.md and CLAUDE.md at the project root, which is why it declares one path more than the cursor harness does. Only .mdc counts inside .cursor/rules; Cursor ignores a plain .md there for want of frontmatter. Nested rule folders below .cursor/rules, and AGENTS.md in subdirectories, are read by Cursor and not counted here \u2014 the probe looks one level deep."
}
