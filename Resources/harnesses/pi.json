{
  "formatVersion": 1,
  "id": "pi",
  "name": "PI",
  "process": {
    "pathContains": ["/bin/pi", "/node_modules/@earendil-works/pi-coding-agent/", "/node_modules/@mariozechner/pi-coding-agent/"],
    "names": ["pi"],
    "argv0Contains": ["/@earendil-works/pi-coding-agent/", "/@mariozechner/pi-coding-agent/"],
    "installationProbes": [
      { "method": "npm-current", "path": "/usr/bin/node", "name": "node", "argv0": "/fixture/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js", "expected": true, "evidence": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/index.md", "verifiedAt": "2026-08-26" },
      { "method": "curl", "path": "/usr/bin/node", "name": "pi", "argv0": "/fixture/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js", "expected": true, "evidence": "https://pi.dev/", "verifiedAt": "2026-08-26" },
      { "method": "npm-legacy", "path": "/usr/bin/node", "name": "node", "argv0": "/fixture/lib/node_modules/@mariozechner/pi-coding-agent/dist/cli.js", "expected": true, "evidence": "https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent", "verifiedAt": "2026-08-26" },
      { "method": "name-collision", "path": "/fixture/tools/pilot", "name": "pilot", "argv0": "pilot", "expected": false, "evidence": "https://pi.dev/", "verifiedAt": "2026-08-26" }
    ]
  },
  "compatibility": {
    "level": "fixtureVerified", "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/pi.json"
  },
  "source": {
    "kind": "jsonl",
    "path": "~/.pi/agent/sessions",
    "glob": "*/*.jsonl"
  },
  "map": {
    "cwd": "cwd",
    "model": "modelId",
    "timestamp": "timestamp",
    "inputTokens": "message.usage.input",
    "outputTokens": "message.usage.output",
    "cacheRead": "message.usage.cacheRead",
    "cacheWrite": "message.usage.cacheWrite",
    "cost": "message.usage.cost.total",
    "toolCalls": {
      "path": "message.content",
      "match": { "type": "toolCall" }
    },
    "turnWhere": {
      "type": "message"
    },
    "contextTokens": [
      "message.usage.input",
      "message.usage.cacheRead",
      "message.usage.cacheWrite"
    ],
    "status": {
      "field": "message.role",
      "working": [
        "user",
        "toolResult"
      ],
      "idle": [
        "assistant"
      ]
    }
  },
  "note": "PI writes the user's message when a turn starts and the assistant's when it ends, so the last role is the state. Without this the row only changed once the transcript had been quiet for idleAfter seconds, which made a long turn look idle."
}
