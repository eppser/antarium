{
  "formatVersion": 1,
  "id": "hermes",
  "name": "Hermes",
  "process": { "pathContains": ["/.hermes/"] },
  "compatibility": {
    "level": "fixtureVerified", "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/hermes.json"
  },
  "source": {
    "kind": "sqlite",
    "path": "~/.hermes/state.db",
    "query": "SELECT model, tool_call_count, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, estimated_cost_usd, started_at FROM sessions ORDER BY started_at DESC LIMIT 5",
    "columns": ["model", "toolCalls", "inputTokens", "outputTokens", "cacheRead", "cacheWrite", "cost", "startedAt"]
  },
  "presentation": { "fallbackName": "Hermes" }
}
