{
  "formatVersion": 1,
  "id": "hermes",
  "name": "Hermes",
  "process": {
    "pathContains": ["/.hermes/", "/hermes-agent/"],
    "names": ["hermes", "hermes-agent"],
    "installationProbes": [
      { "method": "curl-user", "path": "/fixture/home/.hermes/hermes-agent/venv/bin/python", "name": "hermes", "argv0": "/fixture/home/.hermes/hermes-agent/venv/bin/hermes", "expected": true, "evidence": "https://github.com/NousResearch/hermes-agent", "verifiedAt": "2026-08-26" },
      { "method": "curl-system", "path": "/usr/local/lib/hermes-agent/venv/bin/python", "name": "hermes", "argv0": "/usr/local/bin/hermes", "expected": true, "evidence": "https://github.com/NousResearch/hermes-agent", "verifiedAt": "2026-08-26" },
      { "method": "nix", "path": "/nix/store/fixture-hermes-agent/bin/hermes", "name": "hermes", "argv0": "hermes", "expected": true, "evidence": "https://github.com/NousResearch/hermes-agent", "verifiedAt": "2026-08-26" },
      { "method": "name-collision", "path": "/fixture/tools/hermes-helper", "name": "hermes-helper", "argv0": "hermes-helper", "expected": false, "evidence": "https://github.com/NousResearch/hermes-agent", "verifiedAt": "2026-08-26" }
    ]
  },
  "compatibility": {
    "level": "fixtureVerified", "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/hermes.json"
  },
  "source": {
    "kind": "sqlite",
    "path": "~/.hermes/state.db",
    "query": "SELECT model, tool_call_count, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, estimated_cost_usd, started_at FROM sessions ORDER BY started_at DESC LIMIT 5",
    "columns": ["model", "toolCalls", "inputTokens", "outputTokens", "cacheRead", "cacheWrite", "cost", "startedAt"]
  },
  "presentation": { "fallbackName": "Hermes" }
}
