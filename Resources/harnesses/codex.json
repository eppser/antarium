{
  "formatVersion": 1,
  "id": "codex",
  "name": "ChatGPT (Codex)",
  "process": {
    "pathContains": [
      "/.codex/packages/standalone/",
      "/node_modules/@openai/codex-",
      "/Caskroom/codex/"
    ],
    "names": [
      "codex"
    ],
    "sessionBinding": "openSourceFile",
    "installationProbes": [
      {
        "method": "curl",
        "path": "/fixture/home/.codex/packages/standalone/releases/1.2.3-darwin-arm64/bin/codex",
        "name": "codex",
        "argv0": "codex",
        "expected": true,
        "evidence": "https://github.com/openai/codex/blob/main/README.md",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "npm",
        "path": "/fixture/lib/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/codex/codex",
        "name": "codex",
        "argv0": "codex",
        "expected": true,
        "evidence": "https://github.com/openai/codex/blob/main/README.md",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "homebrew-cask",
        "path": "/opt/homebrew/Caskroom/codex/1.2.3/codex",
        "name": "codex",
        "argv0": "codex",
        "expected": true,
        "evidence": "https://github.com/openai/codex/blob/main/README.md",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "release-binary",
        "path": "/fixture/custom/bin/codex",
        "name": "codex",
        "argv0": "codex",
        "expected": true,
        "evidence": "https://github.com/openai/codex/releases",
        "verifiedAt": "2026-08-26"
      },
      {
        "method": "helper-collision",
        "path": "/Applications/ChatGPT.app/Contents/Resources/codex-app-server",
        "name": "codex-app-server",
        "argv0": "codex-app-server",
        "expected": false,
        "evidence": "https://github.com/openai/codex",
        "verifiedAt": "2026-08-26"
      }
    ]
  },
  "compatibility": {
    "level": "fixtureVerified",
    "verifiedAt": "2026-08-25",
    "fixture": "harness-fixtures/codex.json"
  },
  "source": {
    "kind": "jsonl",
    "path": "~/.codex/sessions",
    "glob": "*/*/*/*.jsonl",
    "filter": {
      "payload.originator": [
        "codex-tui",
        "codex_exec"
      ]
    },
    "paths": {
      "goals": "~/.codex/goals_1.sqlite"
    }
  },
  "map": {
    "cwd": "payload.cwd",
    "model": "payload.model",
    "timestamp": "timestamp",
    "inputTokens": "payload.info.last_token_usage.input_tokens",
    "outputTokens": "payload.info.last_token_usage.output_tokens",
    "cacheWrite": "payload.info.last_token_usage.cache_write_input_tokens",
    "cacheRead": "payload.info.last_token_usage.cached_input_tokens",
    "toolWhere": {
      "payload.type": "custom_tool_call"
    },
    "status": {
      "field": "payload.type",
      "working": [
        "task_started"
      ],
      "idle": [
        "task_complete"
      ]
    },
    "contextWindow": "payload.info.model_context_window",
    "contextTokens": [
      "payload.info.last_token_usage.input_tokens"
    ],
    "sessionID": "payload.session_id",
    "inputIncludesCacheRead": true,
    "skipRepeatedUsage": true
  },
  "capabilities": {
    "instruction": {
      "probe": "content",
      "project": [
        "AGENTS.override.md",
        "AGENTS.md"
      ],
      "inherited": [
        "~/.codex/AGENTS.override.md",
        "~/.codex/AGENTS.md"
      ]
    },
    "skills": {
      "probe": "directory",
      "project": [
        ".agents/skills"
      ],
      "inherited": [
        "~/.agents/skills"
      ]
    },
    "mcp": {
      "probe": "toml",
      "project": [
        ".codex/config.toml"
      ],
      "inherited": [
        "~/.codex/config.toml"
      ],
      "keys": [
        "mcp_servers"
      ]
    },
    "permission": {
      "probe": "toml",
      "project": [
        ".codex/config.toml"
      ],
      "inherited": [
        "~/.codex/config.toml"
      ],
      "keys": [
        "approval_policy",
        "sandbox_mode",
        "default_permissions",
        "permissions"
      ]
    }
  },
  "note": " Codex re-emits a `token_count` event verbatim \u2014 the same `last_token_usage` and the same totals written again \u2014 so `skipRepeatedUsage` is declared and an identical consecutive record is counted once. Measured by a reader with a real rollout file on hand: ninety-four events, twelve of them re-emissions, and summing all of them overcounted by about fifteen per cent. The cost of the rule is that two consecutive turns spending exactly the same tokens are read as one, which is the cheaper of the two errors here and is why it is declared per harness rather than applied to every source. Recorded 2026-09-25."
}
