{
  "note": "Synthetic. Shape follows MiniMax's coding_plan/remains payload, including the epoch-millisecond end_time. Every value is invented. current_interval_usage_count is what remains, so a window with 255 of 1500 left is 83% used, not 17%. One case added 2026-09-27 from a probe with an invalid token: this endpoint reports a rejected credential in the body with an HTTP 200, so UsageHTTP's 401 handling never fires. The values are the service's own error shape and carry no account data.",
  "verifiedAt": "2026-09-20",
  "cases": [
    {
      "name": "two metered models",
      "response": {
        "base_resp": {
          "status_code": 0,
          "status_msg": "success"
        },
        "model_remains": [
          {
            "model_name": "minimax-m2",
            "current_interval_total_count": 1500,
            "current_interval_usage_count": 255,
            "end_time": 1790000000000
          },
          {
            "model_name": "minimax-m1",
            "current_interval_total_count": 500,
            "current_interval_usage_count": 400,
            "end_time": 1790000000000
          },
          {
            "model_name": "minimax-unmetered",
            "current_interval_total_count": 0,
            "current_interval_usage_count": 0,
            "end_time": 1790000000000
          }
        ]
      },
      "expected": {
        "gauges": [
          {
            "id": "minimax-m2",
            "badge": "M2",
            "title": "M2",
            "usedPercent": 83,
            "resetsAt": "2026-09-21T14:13:20Z"
          },
          {
            "id": "minimax-m1",
            "badge": "M1",
            "title": "M1",
            "usedPercent": 20,
            "resetsAt": "2026-09-21T14:13:20Z"
          }
        ]
      }
    },
    {
      "name": "every model unmetered",
      "response": {
        "base_resp": {
          "status_code": 0
        },
        "model_remains": [
          {
            "model_name": "minimax-m2",
            "current_interval_total_count": 0,
            "current_interval_usage_count": 0
          }
        ]
      },
      "expectError": "unsupported"
    },
    {
      "name": "error reply carries no windows",
      "response": {
        "base_resp": {
          "status_code": 1001,
          "status_msg": "invalid api key"
        },
        "model_remains": []
      },
      "expectError": "unsupported"
    },
    {
      "name": "the reply a missing cookie gets, which arrives with an HTTP 200",
      "response": {
        "base_resp": {
          "status_code": 1004,
          "status_msg": "cookie is missing, log in again"
        }
      },
      "expectError": "needsAuth"
    }
  ]
