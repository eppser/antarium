{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.schema.json",
  "title": "Antarium harness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "process",
    "source"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matchProcessName": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "map": {
      "$ref": "#/$defs/map"
    },
    "quota": {
      "$ref": "#/$defs/quota"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "instruction",
          "memory",
          "skills",
          "mcp",
          "permission"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "idleAfter": {
      "type": "number",
      "minimum": 0
    },
    "staleAfter": {
      "type": "number",
      "minimum": 0
    },
    "fallbackName": {
      "type": "string"
    },
    "mark": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "detached": {
      "type": "boolean"
    },
    "multiSession": {
      "type": "boolean"
    },
    "openTabsOnly": {
      "type": "boolean",
      "deprecated": true
    },
    "enabled": {
      "type": "boolean"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "multiSession": {
            "const": true
          }
        },
        "required": [
          "multiSession"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "map"
            ],
            "properties": {
              "map": {
                "required": [
                  "sessionID"
                ]
              }
            }
          },
          {
            "properties": {
              "source": {
                "required": [
                  "columns"
                ],
                "properties": {
                  "columns": {
                    "contains": {
                      "const": "sessionID"
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "required": [
                  "pathFields"
                ],
                "properties": {
                  "pathFields": {
                    "required": [
                      "sessionID"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "process": {
            "properties": {
              "sessionBinding": {
                "const": "openSourceFile"
              }
            },
            "required": [
              "sessionBinding"
            ]
          }
        },
        "required": [
          "process"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "enum": [
                  "json",
                  "jsonl"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pathContains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "argv0Contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sessionBinding": {
          "enum": [
            "openSourceFile"
          ]
        },
        "installationProbes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/installationProbe"
          }
        }
      }
    },
    "installationProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "name",
        "argv0",
        "expected",
        "evidence",
        "verifiedAt"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "argv0": {
          "type": "string"
        },
        "expected": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mark": {
          "type": "string"
        },
        "fallbackName": {
          "type": "string"
        },
        "sourceLabel": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "experimental",
            "declared",
            "fixtureVerified",
            "liveVerified"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        },
        "agentVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixture": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "fixtureVerified",
                  "liveVerified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "verifiedAt",
              "fixture"
            ]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "jsonl",
            "json",
            "sqlite",
            "command",
            "none"
          ]
        },
        "path": {
          "type": "string"
        },
        "glob": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "journal": {
          "type": "boolean"
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pathFields": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "cwd",
              "title",
              "model",
              "sessionID"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/pathField"
          }
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "$ref": "#/$defs/stringListMap"
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "map"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "map": {
              "$ref": "#/$defs/map"
            }
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "type": "string"
        },
        "refreshEvery": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sqlite"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "query",
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "jsonl",
                  "json"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "glob"
            ]
          }
        }
      ]
    },
    "pathField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ancestor",
        "value"
      ],
      "properties": {
        "ancestor": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "enum": [
            "name",
            "stem",
            "path"
          ]
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "contextWindow": {
          "type": "string"
        },
        "contextTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp": {
          "type": "string"
        },
        "inputTokens": {
          "type": "string"
        },
        "outputTokens": {
          "type": "string"
        },
        "cacheRead": {
          "type": "string"
        },
        "cacheWrite": {
          "type": "string"
        },
        "inputIncludesCacheRead": {
          "type": "boolean"
        },
        "cost": {
          "type": "string"
        },
        "toolMarker": {
          "type": "string"
        },
        "toolWhere": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "toolCalls": {
          "$ref": "#/$defs/count"
        },
        "turnWhere": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "turns": {
          "$ref": "#/$defs/count"
        },
        "subAgents": {
          "$ref": "#/$defs/count"
        },
        "pid": {
          "type": "string"
        },
        "sessionID": {
          "type": "string"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whileNotEmpty": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "working": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "idle": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe": {
          "enum": [
            "content",
            "directory",
            "jsonObject",
            "toml"
          ]
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "jsonFiles",
            "sqlite",
            "command"
          ]
        },
        "path": {
          "type": "string"
        },
        "glob": {
          "type": "string"
        },
        "records": {
          "type": "string"
        },
        "encodedJSON": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "filter": {
          "$ref": "#/$defs/stringListMap"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "jsonFiles"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "glob",
              "records",
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sqlite"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "query",
              "column"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "command",
              "id"
            ]
          }
        }
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "windows"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "credential": {
          "$ref": "#/$defs/credential"
        },
        "windows": {
          "$ref": "#/$defs/windows"
        },
        "accountLabel": {
          "type": "string"
        },
        "setupHint": {
          "type": "string"
        },
        "signInCommand": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "jsonFile",
            "textFile",
            "env",
            "command"
          ]
        },
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "list": {
          "type": "string",
          "description": "Dot-path to an array of windows. Supersedes root."
        },
        "key": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Field paths inside each list element that name that window; several are joined with '-'."
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usedPercent": {
          "type": "string"
        },
        "percentRemaining": {
          "type": "string"
        },
        "used": {
          "type": "string"
        },
        "limit": {
          "type": "string"
        },
        "require": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "badges": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "description": "Explicit menu-bar badge per window, when the label abbreviates badly."
        },
        "windowSeconds": {
          "type": "string"
        },
        "resetsAt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "usedPercent"
          ]
        },
        {
          "required": [
            "percentRemaining"
          ]
        },
        {
          "required": [
            "used",
            "limit"
          ]
        }
      ]
    },
    "stringListMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  }
}
